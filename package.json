{
  "name": "lexa",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Lexa — Tetris de mots competitif en ASCII",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "dict:build": "tsx scripts/build-dict.ts",
    "simulate": "tsx scripts/simulate.ts"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "an-array-of-french-words": "^2.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
